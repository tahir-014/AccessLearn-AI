# AccessLearn AI Backend Configuration
# Obtain your Gemini API key from Google AI Studio: https://aistudio.google.com/
# Leave empty or unset to automatically run in Demo/Mock AI mode.
GEMINI_API_KEY=

# Application settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# SQLite Database path (defaults to accesslearn.db in app directory)
DATABASE_URL=sqlite:///./accesslearn.db

# Allowed Origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
